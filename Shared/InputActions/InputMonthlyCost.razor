@using BetterBudgetWeb.Data
@using BetterBudgetWeb.Repo
@if (Mobile)
{
    <br />
    <br />
    <div>
        <label>Expense Name:</label>
        <br />
        <input class="custom-input" type="text" placeholder="Expense Name" @bind-value="@StaticName" @oninput="@(async (ui) => { StaticName = (string)ui.Value; })" />
    </div>
    <br />
    <div>
        <label>Type of Recurring Charge:</label>
        <br />
        <FancySelect @bind-Value="Dyna" Style="">
            <option value="@string.Empty" selected disabled="disabled">(Select Type)</option>
            <option value="DYNAMIC">Budget Category</option>
            <option value="STATIC">One-time Monthly Charge</option>
        </FancySelect>
    </div>
    <br />
    <div>
        <label>When (Month Year):</label>
        <br />
        <FancySelect @bind-Value="SelectMonth" Style="">
            @foreach (var item in Months)
            {
                <option value="@item">@item</option>
            }
        </FancySelect>
        <FancySelect @bind-Value="SelectYear" Style="">
            <option value="1">All</option>
            <option value="@DateTime.Now.Year.ToString()">@DateTime.Now.Year</option>
            <option value="@DateTime.Now.AddYears(1).Year.ToString()">@DateTime.Now.AddYears(1).Year</option>
        </FancySelect>
    </div>
    <br />
    @if (Dyna == "DYNAMIC")
    {
        <div>
            <label>@("Total Amount:")</label>
            <br />
            <CustomCurrencyInput @bind-Value=TotalAmount />
        </div>
    }
    else
    {
        <div>
            <label>@(Constants.Person1 + " Amount:")</label>
            <br />
            <CustomCurrencyInput @bind-Value=Person1Amount />
        </div>
        <br />
        <div>
            <label>@(Constants.Person2 + " Amount:")</label>
            <br />
            <CustomCurrencyInput @bind-Value=Person2Amount />
        </div>
    }
    <br style="clear:both;" />

    <br style="clear:both" />
    <button class="btn btn-primary" disabled=@Disabled @onclick="Submit">Submit</button>
    <br />
    @if (!string.IsNullOrEmpty(ErrorMsg))
    {
        <p style="color:@ErrorColor">@ErrorMsg</p>
    }
}
else
{
    <div class="tabcontent">
        <div style="float:left; margin-right:10vw;">
            <label>Expense Name:</label>
            <br />
            <input class="custom-input" type="text" placeholder="Expense Name" @bind-value="@StaticName" @oninput="@(async (ui) => { StaticName = (string)ui.Value; })" />
        </div>
        <br style="clear:both;" />
        <br />
        <div style="float:left;margin-right:10vw;">
            <label>Type of Recurring Charge:</label>
            <br />
            <FancySelect @bind-Value="Dyna" Style="">
                <option value="@string.Empty" selected disabled="disabled">(Select Type)</option>
                <option value="DYNAMIC">Budget Category</option>
                <option value="STATIC">One-time Monthly Charge</option>
            </FancySelect>
        </div>
        <div style="float:left;margin-right:10vw;">
            <label>When (Month Year):</label>
            <br />
            <FancySelect @bind-Value="SelectMonth" Style="">
                @foreach (var item in Months)
                {
                    <option value="@item">@item</option>
                }
            </FancySelect>
            <FancySelect @bind-Value="SelectYear" Style="">
                <option value="1">All</option>
                <option value="@DateTime.Now.Year.ToString()">@DateTime.Now.Year</option>
                <option value="@DateTime.Now.AddYears(1).Year.ToString()">@DateTime.Now.AddYears(1).Year</option>
            </FancySelect>
        </div>
        <br style="clear:both;" />
        <br />
        @if (Dyna == "DYNAMIC")
        {
            <div>
                <label>@("Total Amount:")</label>
                <br />
                <CustomCurrencyInput @bind-Value=TotalAmount />
            </div>
        }
        else
        {
            <div style="float:left;margin-right:10vw;">
                <label>@(Constants.Person1 + " Amount:")</label>
                <br />
                <CustomCurrencyInput @bind-Value=Person1Amount />
            </div>
            <div style="float:left;margin-right:10vw;">
                <label>@(Constants.Person2 + " Amount:")</label>
                <br />
                <CustomCurrencyInput @bind-Value=Person2Amount />
            </div>
        }
        <br style="clear:both;" />

        <br style="clear:both" />
        <button class="btn btn-primary" disabled=@Disabled @onclick="Submit">@(Updating ? "Update" : "Add")</button>
        <br />
        @if (!string.IsNullOrEmpty(ErrorMsg))
        {
            <p style="color:@ErrorColor">@ErrorMsg</p>
        }
    </div>
}
<br />
<br />

@code {
    private Monthly selectedMonthly { get; set; }
    [Parameter]
    public Monthly SelectedMonthly
    {
        get { return selectedMonthly; }
        set
        {
            if (selectedMonthly == value)
                return;

            selectedMonthly = value;
            SetMonthly();
            SelectedMonthlyChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<Monthly> SelectedMonthlyChanged { get; set; }

    [Parameter]
    public bool Updating { get; set; }

    [Parameter]
    public string StaticName { get; set; }

    public double Person1Amount { get; set; }
    public double Person2Amount { get; set; }
    public double TotalAmount { get; set; }

    public bool Mobile => Constants.Mobile;

    List<string> Months { get; set; } = new List<string>();
    string SelectMonth { get; set; } = "All";
    string SelectYear { get; set; } = "1";
    string Dyna { get; set; }

    bool Disabled;

    private string ErrorMsg { get; set; } = string.Empty;
    private string ErrorColor { get; set; } = "red";

    protected override Task OnInitializedAsync()
    {
        List<string> theMons = new List<string>{"January", "February",
                                            "March", "April", "May", "June", "July", "August", "September",
                                            "October", "November", "December"};
        int thisYear = DateTime.Now.Year;

        Months.Add("All");
        int startMonth = DateTime.Now.Month - 1;
        for (int index = startMonth; index < startMonth + 12; index++)
        {
            if (theMons[index % 12] == "January" && DateTime.Now.Month != 1)
                thisYear++;

            Months.Add(theMons[index % 12]);
        }

        Months.Sort(Constants.SortMonths);
        return base.OnInitializedAsync();
    }

    private void SetMonthly()
    {
        if (SelectedMonthly != null)
        {
            Dyna = SelectedMonthly.Dynamic;
            Person1Amount = SelectedMonthly.Person1Amount;
            Person2Amount = SelectedMonthly.Person2Amount;
            StaticName = SelectedMonthly.Name;
            SelectMonth = SelectedMonthly.Month;
            SelectYear = SelectedMonthly.Year;

            TotalAmount = (Person1Amount + Person2Amount);
        }
    }

    public async void Submit()
    {
        Disabled = true;
        ErrorMsg = string.Empty;
        ErrorColor = "red";

        if (Dyna == "DYNAMIC")
        {
            Person1Amount = Math.Ceiling(TotalAmount / 2);
            Person2Amount = Math.Floor(TotalAmount / 2);
        }
        else
        {
            TotalAmount = Person1Amount + Person2Amount;
        }

        ErrorMsg += Dyna != "SAVINGS" && string.IsNullOrEmpty(StaticName) ? "Static Name must be set. " : "";
        ErrorMsg += TotalAmount <= 0 ? $"Total Amount must be > 0. " : "";
        ErrorMsg += string.IsNullOrEmpty(Dyna) ? "Cost Type must be specified. " : "";
        //ErrorMsg += !string.IsNullOrEmpty(ExpenseType) && ExpenseType == "Debt" ? "APR must be a number. " : "";
        //ErrorMsg += string.IsNullOrEmpty(Color) ? "Color must be set." : "";

        if (string.IsNullOrEmpty(ErrorMsg))
        {
            string mon;
            string year;
            string id = SelectedMonthly == null ? "" : SelectedMonthly.Id;
            var mons = await MonthlyRepo.AddOrUpdateAsync(StaticName, Person1Amount, Person2Amount, Dyna, SelectMonth + " " + SelectYear, id);

            ErrorColor = "green";
            ErrorMsg = $"'{StaticName}' recurring transaction was {(Updating ? "updated" : "added")}!";

            StaticName = string.Empty;
            Person1Amount = 0;
            Person2Amount = 0;

            Constants.SetMonthlies(mons);
        }

        Disabled = false;
        StateHasChanged();
    }
}

